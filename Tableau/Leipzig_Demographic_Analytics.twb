      <column aggregation='Sum' caption='Alter' datatype='integer' name='[Alter Alter]' role='dimension' type='ordinal' />
      <column caption='Auslaendische Frauen' datatype='integer' name='[Auslaendische Frauen Auslaendische Frauen]' role='measure' type='quantitative' />
      <column caption='Auslaendische Maenner' datatype='integer' name='[Auslaendische Maenner Auslaendische Maenner]' role='measure' type='quantitative' />
      <column caption='Total Deutsche population' datatype='integer' name='[Calculation_0532163679883264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Deutsche Frauen Deutsche Frauen] + [Deutsche Maenner Deutsche Maenner]' />
      </column>
      <column caption='Total Auslandische' datatype='integer' name='[Calculation_0532163680948225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Auslaendische Frauen Auslaendische Frauen]+[Auslaendische Maenner Auslaendische Maenner]' />
      </column>
      <column caption='Total population' datatype='integer' name='[Calculation_0532163681198083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Deutsche Frauen Deutsche Frauen])+SUM([Deutsche Maenner Deutsche Maenner])+SUM([Auslaendische Frauen Auslaendische Frauen])+sum([Auslaendische Maenner Auslaendische Maenner])' />
      </column>
      <column caption='total Maenner' datatype='integer' name='[Calculation_0532163681771524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Deutsche Frauen Deutsche Frauen])+SUM([Deutsche Maenner Deutsche Maenner])' />
      </column>
      <column caption='Maenner' datatype='integer' name='[Calculation_1849929851596800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[Deutsche Maenner Deutsche Maenner] - [Auslaendische Maenner Auslaendische Maenner]' />
      </column>
      <column caption='Frauen' datatype='integer' name='[Calculation_1849929851662337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Deutsche Frauen Deutsche Frauen] + [Auslaendische Frauen Auslaendische Frauen]' />
      </column>
      <column caption='Age group' datatype='string' name='[Calculation_1849929859874818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Alter Alter] &lt;= 14 THEN &quot;Children (0-14)&quot;&#13;&#10;ELSEIF [Alter Alter] &lt;= 24 THEN &quot;Youth (15-24)&quot;&#13;&#10;ELSEIF [Alter Alter] &lt;= 64 THEN &quot;Working Age (25-64)&quot;&#13;&#10;ELSE &quot;Elderly (65+)&quot;&#13;&#10;END' />
      </column>
      <column caption='Deutsche Growth Rate' datatype='real' name='[Calculation_1849929862823943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0532163679883264]) - LOOKUP(SUM([Calculation_0532163679883264]), -1))&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([Calculation_0532163679883264]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Auslaendische Growth rate' datatype='real' name='[Calculation_1849929863434248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0532163680948225]) - LOOKUP(SUM([Calculation_0532163680948225]), -1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([Calculation_0532163680948225]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest year' datatype='integer' name='[Calculation_1849929881100297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Jahr Jahr])' />
      </column>
      <column caption='First Year' datatype='integer' name='[Calculation_1849929882632202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED :MIN([Jahr Jahr])}' />
      </column>
      <column caption='KPI Population (latest year)' datatype='integer' name='[Calculation_1849929882861579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Jahr Jahr] = { FIXED : MAX([Jahr Jahr]) }&#13;&#10;THEN [Deutsche Frauen Deutsche Frauen] + [Deutsche Maenner Deutsche Maenner] + [Auslaendische Frauen Auslaendische Frauen] + [Auslaendische Maenner Auslaendische Maenner]&#13;&#10;END)' />
      </column>
      <column caption='KPI % Foreign' datatype='real' name='[Calculation_1849929884098572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Jahr Jahr] = { FIXED : MAX([Jahr Jahr]) }&#13;&#10;THEN [Auslaendische Maenner Auslaendische Maenner] + [Auslaendische Frauen Auslaendische Frauen] END)&#13;&#10;/&#13;&#10;SUM(IF [Jahr Jahr] = { FIXED : MAX([Jahr Jahr]) }&#13;&#10;THEN [Deutsche Frauen Deutsche Frauen] + [Deutsche Maenner Deutsche Maenner] + [Auslaendische Frauen Auslaendische Frauen] + [Auslaendische Maenner Auslaendische Maenner] END)' />
      </column>
      <column caption='KPI Growth since first year' datatype='real' name='[Calculation_1849929884340237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Jahr Jahr] = { FIXED : MAX([Jahr Jahr]) }&#13;&#10;THEN [Deutsche Frauen Deutsche Frauen] + [Deutsche Maenner Deutsche Maenner] + [Auslaendische Frauen Auslaendische Frauen] + [Auslaendische Maenner Auslaendische Maenner] END)&#13;&#10;/&#13;&#10;SUM(IF [Jahr Jahr] = { FIXED : MIN([Jahr Jahr]) }&#13;&#10;THEN [Deutsche Frauen Deutsche Frauen] + [Deutsche Maenner Deutsche Maenner] + [Auslaendische Frauen Auslaendische Frauen] + [Auslaendische Maenner Auslaendische Maenner] END)&#13;&#10;- 1' />
      </column>
      <column caption='KPI Average Age (latest year)' datatype='real' name='[Calculation_1849929884557326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Jahr Jahr] = { FIXED : MAX([Jahr Jahr]) }&#13;&#10;THEN [Alter Alter] * ([Deutsche Frauen Deutsche Frauen] + [Deutsche Maenner Deutsche Maenner] + [Auslaendische Frauen Auslaendische Frauen] + [Auslaendische Maenner Auslaendische Maenner]) END)&#13;&#10;/&#13;&#10;SUM(IF [Jahr Jahr] = { FIXED : MAX([Jahr Jahr]) }&#13;&#10;THEN [Deutsche Frauen Deutsche Frauen] + [Deutsche Maenner Deutsche Maenner] + [Auslaendische Frauen Auslaendische Frauen] + [Auslaendische Maenner Auslaendische Maenner] END)' />
